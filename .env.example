# 复制为 .env 后按需覆盖 settings.yaml。不要提交此文件、API Key 或加密密钥。

# cc-switch SQLite 数据库路径。
# CCS_PLUS_DATABASE__PATH=~/.cc-switch/cc-switch.db

# Claude、Codex、Grok 的稳定 state home；切换供应商时保留各自原生会话。
# CCS_PLUS_APPS__CLAUDE__HOME=data/claude
# CCS_PLUS_APPS__CODEX__HOME=data/codex
# CCS_PLUS_APPS__GROK__HOME=data/grok

# 新增 Codex 供应商时写入 settings_config 的默认策略（launch 读供应商实际配置）。
# CCS_PLUS_APPS__CODEX__APPROVAL_POLICY=never
# CCS_PLUS_APPS__CODEX__SANDBOX_MODE=danger-full-access

# 通用 Fernet 加密密钥，供 providers export/import 及后续加密场景使用。
# 生成命令：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CCS_PLUS_ENCRYPTION_KEY=replace-with-a-fernet-key
