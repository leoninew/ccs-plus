# 复制为 .env 后按需覆盖 settings.yaml。不要提交此文件、API Key 或加密密钥。

# cc-switch SQLite 数据库路径。
# CCS_PLUS_DATABASE__PATH=~/.cc-switch/cc-switch.db

# Claude、Codex、Grok 启动时共用的网络代理。留空会清除父进程继承的代理变量。
CCS_PLUS_PROXY=

# Claude、Grok 的稳定 state home；Codex 直接使用其真实 user Home。
# CCS_PLUS_APPS__CLAUDE__HOME=data/claude
# Claude 启动时传给 --permission-mode 的值。
# CCS_PLUS_APPS__CLAUDE__PERMISSION_MODE=bypassPermissions
# Claude user-home MCP 的 JSON 键。skills/plugins 的 copy/skip 规则在 settings.yaml
# 的 apps.claude.visibility 中维护。
# CCS_PLUS_APPS__CLAUDE__VISIBILITY__MCP_KEY=mcpServers
# CCS_PLUS_APPS__GROK__HOME=data/grok
# CCS_PLUS_APPS__CODEX__USER_HOME=~/.codex
# Grok 启动时传给 --sandbox 的值，以及是否传入 --always-approve。
# CCS_PLUS_APPS__GROK__SANDBOX_MODE=workspace
# CCS_PLUS_APPS__GROK__ALWAYS_APPROVE=true
# CCS_PLUS_APPS__CODEX__SESSION_MODEL_PROVIDER=ccs-plus-managed

# 新增 Codex 供应商时写入 settings_config 的默认策略（launch 读供应商实际配置）。
# CCS_PLUS_APPS__CODEX__APPROVAL_POLICY=never
# CCS_PLUS_APPS__CODEX__SANDBOX_MODE=danger-full-access

# visibility 的表列表和 copy/skip 列表由 Claude、Grok 的 settings.yaml 节点维护：
# apps.claude.visibility、apps.grok.visibility。当前 Dynaconf
# 嵌套合并会追加环境变量中的列表，不适合用 .env 替换这些默认列表；需要调整列表时请
# 直接修改 settings.yaml。仅在明确要追加表时，可使用：
# CCS_PLUS_APPS__GROK__VISIBILITY__EXTENSION_KEYS='["mcp_servers", "plugins"]'

# 通用 Fernet 加密密钥，供 providers export/import 及后续加密场景使用。
# 生成命令：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CCS_PLUS_ENCRYPTION_KEY=replace-with-a-fernet-key
